{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LamsEX",
  "version": "0.1.0",
  "identifier": "com.cosmica.lamsex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LamsEX",
        "width": 1280,
        "height": 720,
        "minWidth": 100,
        "minHeight": 100,
        "resizable": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
